{
  "name": "headless-recorder",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "dev": "bun run clean && vite build --mode development --watch",
    "serve": "bun run dev",
    "build": "bun run clean && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bun run build && vitest run --config vitest.integration.config.js",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@medv/finder": "4.0.2",
    "highlight.js": "11.12.0",
    "vue": "3.5.42",
    "vue-tippy": "6.7.1",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.42",
    "@vue/test-utils": "2.5.0",
    "express": "5.2.1",
    "happy-dom": "20.12.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "puppeteer": "25.9.0",
    "sass-embedded": "1.103.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.4.0"
}
